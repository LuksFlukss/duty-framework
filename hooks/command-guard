#!/usr/bin/env bash
# Claude Code PreToolUse hook on Bash: denies git writes, and asks the user (permission prompt) before
# apply/deploy commands run, with a DESTRUCTIVE: marker on deletes.
# A safety net against mistakes, not a security boundary: bash -c, eval, scripts and aliases get past it.
# Lifted for a session by starting Claude Code with DUTY_ALLOW_GIT_WRITE=1 or DUTY_ALLOW_APPLY=1;
# an assignment inside the command itself is part of the command and lifts nothing.
set -uo pipefail

# Read stdin first, so the caller never writes into a closed pipe. Builtin read on fd 0:
# Claude Code passes a socket, where opening /dev/stdin fails; no cat, so it works without PATH.
IFS= read -r -d '' input || true
[ -n "${COPILOT_CLI:-}" ] && exit 0
command -v jq >/dev/null || exit 0
cmd=$(printf '%s' "$input" | jq -r 'select(.tool_name == "Bash") | .tool_input.command | strings' 2>/dev/null) || exit 0
[ -n "$cmd" ] || exit 0

# Join backslash line continuations.
cmd=${cmd//$'\\\n'/ }
# Quoted text is an argument, not a command: replace it with a placeholder, unpadded so it stays
# part of its word: an option's value (git -C "my dir" push, -c a="b", FOO='x' git push), never a command.
q_re="\"([^\"\\\\]|\\\\.)*\"|'[^']*'"
while [[ $cmd =~ $q_re ]]; do cmd=${cmd/"${BASH_REMATCH[0]}"/_q_}; done
# Split into simple commands on ; & | ( ) ` < > and newlines.
cmd=${cmd//$'\n'/;}
cmd=${cmd//[|&()\`<>]/;}

# Positional words of a command line (P), skipping options and the values of options that take one;
# R: the words after the first positional (the subcommand's own arguments).
positionals() { # tool, args...
  local t=$1 vf=' ' skip=0 a n=0; shift; P=(); R=()
  case $t in
    git) vf=' -C -c --git-dir --work-tree --namespace --sort --format ' ;;
    kubectl) vf=' -n --namespace --context --kubeconfig --cluster --user -s --server --as -f --filename -p --patch -o --output -l --selector -v ' ;;
    helm) vf=' -n --namespace --kube-context --kubeconfig ' ;;
    gh) vf=' -R --repo ' ;;
    terragrunt) vf=' --terragrunt-working-dir --terragrunt-config --terragrunt-source --working-dir --config ' ;;
    pulumi) vf=' -C --cwd -s --stack ' ;;
    # ansible-navigator: settings with a value (they can come before the subcommand: --mode stdout run)
    ansible-navigator) vf=' -m --mode --ee --execution-environment --eei --execution-environment-image --ce --container-engine --lf --log-file --ll --log-level --la --log-append --pp --pull-policy --senv --set-environment-variable --penv --pass-environment-variable --eev --execution-environment-volume-mounts --co --container-options --pae --playbook-artifact-enable --pas --playbook-artifact-save-as --rac --rotate-artifacts-count --tz --time-zone --dc --display-color -i --inventory --ecmd --exec-command ' ;;
    az) vf=' -n --name -g --resource-group --subscription -l --location --query -o --output --ids ' ;;
    # aws: global options with a value, and the s3 transfer options whose value would pass for the last positional
    aws) vf=' --region --profile --output --query --endpoint-url --color --cli-read-timeout --cli-connect-timeout --ca-bundle --cli-binary-format --exclude --include --acl --storage-class --sse --sse-kms-key-id --cache-control --content-type --content-disposition --content-encoding --content-language --expires --metadata --metadata-directive --grants --source-region --page-size ' ;;
  esac
  for a in "$@"; do
    n=$((n + 1))
    if [ $skip = 1 ]; then skip=0
    elif [[ $vf == *" $a "* ]]; then skip=1
    elif [[ $a != -* || $a == - ]]; then # a lone - is a positional (stdin/stdout)
      [ ${#P[@]} -eq 0 ] && R=("${@:n+1}")
      P+=("$a")
    fi
  done
}
has() { # word, args... : true if word is one of args
  local w=$1 a; shift
  for a in "$@"; do [ "$a" = "$w" ] && return 0; done
  return 1
}
hasp() { # glob, args... : true if one of args matches the glob
  local p=$1 a; shift
  for a in "$@"; do [[ $a == $p ]] && return 0; done
  return 1
}

# Prints "apply <label>" for terraform-style verbs (terraform, tofu, terragrunt): tool, verb, next word, word after.
tf_verb() {
  case $2 in
    apply|destroy|import) echo "apply $1 $2" ;;
    state) case $3 in rm|mv|push) echo "apply $1 state $3" ;; esac ;;
  esac
}

# az rest: a write when --method/-m (also --method=x, -m=x, -mx) is put, post, patch or delete; the default is get.
az_rest() { # args after "rest"
  local a m= prev=
  for a in "$@"; do
    case $prev in -m|--method) m=$a ;; esac
    case $a in --method=*|-m=*) m=${a#*=} ;; -m?*) m=${a#-m} ;; esac
    prev=$a
  done
  m=${m,,}
  case $m in
    put|post|patch|delete) echo "apply az rest $m" ;;
    *_q_*) echo "apply az rest --method (quoted)" ;; # a quoted value can't be read: ask to be safe
  esac
}

# Prints "git <label>", "apply <label>" or "ask <label>" for a blocked (or ask-first) simple command.
check() { # words...
  local w=("$@") i=0 t pre=
  # skip prefixes (sudo -u x, env -u x, nice -n 5, timeout -s KILL 60, VAR=val, shell keywords)
  while [ $i -lt ${#w[@]} ]; do
    case ${w[i]} in
      sudo|time|nohup|command|exec|env|nice|timeout|if|then|else|elif|do|while|until|'!'|'{'|'}') pre=${w[i]}; i=$((i + 1)) ;;
      [A-Za-z_]*=*) i=$((i + 1)) ;;
      -*) [ -n "$pre" ] || break
        case "$pre ${w[i]}" in
          'sudo -u'|'sudo -g'|'env -u'|'nice -n'|'timeout -s'|'timeout -k') i=$((i + 2)) ;;
          *) i=$((i + 1)) ;;
        esac ;;
      *) if [ "$pre" = timeout ] && [[ ${w[i]} =~ ^[0-9.]+[smhd]?$ ]]; then pre=; i=$((i + 1)); else break; fi ;;
    esac
  done
  [ $i -lt ${#w[@]} ] || return 0
  t=${w[i]##*/}; w=("${w[@]:i+1}")
  # --dry-run (terraform: -dry-run, aws: --dryrun) only plans; --dry-run=none and =false are real runs
  for a in "${w[@]}"; do [[ $a == --dry-run || $a == -dry-run || $a == --dryrun || ( $a == --dry-run=* && $a != --dry-run=none && $a != --dry-run=false ) ]] && return 0; done
  positionals "$t" "${w[@]}"
  local v=${P[0]:-} s=${P[1]:-}
  case $t in
    git)
      case $v in
        commit|push|pull|merge|rebase|reset|cherry-pick|revert|restore) echo "git git $v" ;;
        stash) [ "$s" = list ] || [ "$s" = show ] || echo "git git stash" ;;
        # subcommand options are checked in R only, so global options (-C dir, -c key=val) don't count
        checkout) { has -- "${R[@]}" || hasp '-[bB]*' "${R[@]}"; } && echo "git git checkout" ;;
        switch) { hasp '-[cC]*' "${R[@]}" || hasp '--create*' "${R[@]}"; } && echo "git git switch" ;;
        branch)
          for a in -d -D -m -M -c -C -f --delete --move --copy --force; do has $a "${R[@]}" && { echo "git git branch $a"; return; }; done
          if [ ${#P[@]} -gt 1 ]; then
            for a in -l --list -a --all -r --remotes --contains --no-contains --merged --no-merged --points-at; do has $a "${R[@]}" && return; done
            echo "git git branch"
          fi ;;
        tag)
          { has -d "${R[@]}" || has --delete "${R[@]}"; } && { echo "git git tag -d"; return; }
          if [ ${#P[@]} -gt 1 ]; then
            for a in -l --list -n -v --verify --contains --no-contains --merged --no-merged --points-at; do has $a "${R[@]}" && return; done
            echo "git git tag"
          fi ;;
      esac ;;
    gh)
      case $v in
        pr) { [ "$s" = create ] || [ "$s" = merge ]; } && echo "git gh pr $s" ;;
        release) case $s in create|delete|upload|edit) echo "apply gh release $s" ;; esac ;;
      esac ;;
    terraform|tofu) tf_verb "$t" "$v" "$s" "${P[2]:-}" ;;
    terragrunt)
      # run-all apply, run --all apply: the terraform verb follows run-all / run
      if [ "$v" = run-all ] || [ "$v" = run ]; then tf_verb terragrunt "$s" "${P[2]:-}"
      elif [ "$v" = apply-all ] || [ "$v" = destroy-all ]; then echo "apply terragrunt $v"
      else tf_verb terragrunt "$v" "$s"; fi ;;
    pulumi) case $v in up|update|destroy) echo "apply pulumi $v" ;; esac ;;
    npm|pnpm|yarn)
      if [ "$v" = publish ] || { [ "$t" = yarn ] && [ "$v" = npm ] && [ "$s" = publish ]; }; then echo "apply $t publish"; fi ;;
    docker) { [ "$v" = push ] || { [ "$v" = image ] && [ "$s" = push ]; }; } && echo "apply docker push" ;;
    az)
      # only the command words count (az group delete): the positionals from the first one up to the first option word.
      # Option values (--tag start, --container-name stop) and words after an option never do.
      # az rest is the exception: its --method/-m decides. invoke (run-command, aks command) runs code on a real
      # machine: "ask" lets the user approve it in the permission prompt instead of a deny.
      local skip=0 started=0 i
      for ((i = 0; i < ${#w[@]}; i++)); do
        a=${w[i]}
        if [ $skip = 1 ]; then skip=0
        elif [[ $a == -* ]]; then
          [ $started = 1 ] && break
          [[ ' -n --name -g --resource-group --subscription -l --location --query -o --output --ids ' == *" $a "* ]] && skip=1
        else
          if [ $started = 0 ] && [ "$a" = rest ]; then az_rest "${w[@]:i+1}"; return; fi
          started=1
          case $a in
            create|delete|update|set|add|remove|start|stop|restart|purge|deallocate|backup-now|attach|detach|resize|redeploy|reimage|restore|delete-*|remove-*|purge-*)
              echo "apply az $a"; return ;;
            invoke) echo "ask az $a"; return ;;
          esac
        fi
      done ;;
    aws)
      # aws <service> <operation>; s3 has high-level commands (rm, mv, ...) besides the s3api-style operations
      case $s in
        delete-*|create-*|put-*|update-*|terminate-*|modify-*|run-*|start-*|stop-*|reboot-*|attach-*|detach-*|associate-*|disassociate-*|register-*|deregister-*|enable-*|disable-*|tag-*|untag-*|restore-*|import-*|revoke-*|authorize-*|execute-*|send-*|deploy|invoke|publish)
          echo "apply aws $v $s" ;;
        rm|mv|rb) [ "$v" = s3 ] && echo "apply aws s3 $s" ;;
        # cp and sync only write when the destination (last positional) is remote
        cp|sync) [ "$v" = s3 ] && [[ ${P[${#P[@]}-1]} == s3://* ]] && echo "apply aws s3 $s" ;;
      esac ;;
    kubectl)
      case $v in
        apply|create|delete|patch|replace|scale) echo "apply kubectl $v" ;;
        rollout) [ "$s" = restart ] && echo "apply kubectl rollout restart" ;;
      esac ;;
    helm) case $v in install|upgrade|uninstall|delete|rollback) echo "apply helm $v" ;; esac ;;
    # ansible connects to real hosts and runs modules (--check too); syntax checks, listings, version and help don't.
    # Only words before a lone -- count as its options (exec -- psql -h db: -h belongs to psql).
    ansible|ansible-playbook|ansible-navigator|ansible-pull|ansible-console|ansible-runner)
      local o=() a
      for a in "${w[@]}"; do [ "$a" = -- ] && break; o+=("$a"); done
      for a in --version -h --help; do has $a "${o[@]}" && return 0; done
      case $t in
        ansible) has --list-hosts "${o[@]}" || echo "apply ansible" ;;
        ansible-playbook)
          for a in --syntax-check --list-hosts --list-tasks --list-tags; do has $a "${o[@]}" && return 0; done
          echo "apply ansible-playbook" ;;
        ansible-navigator)
          # only run (a playbook) and exec (any command in the execution environment) reach hosts. The subcommand is
          # the first known one: an unlisted option with a value can't hide it (--unknown x run).
          v=
          for a in "${P[@]}"; do
            case $a in builder|collections|config|doc|exec|images|inventory|lint|replay|run|settings|welcome) v=$a; break ;; esac
          done
          case $v in
            run) for a in --syntax-check --list-hosts --list-tasks --list-tags; do has $a "${o[@]}" && return 0; done
              echo "apply ansible-navigator run" ;;
            exec) echo "apply ansible-navigator exec" ;;
          esac ;;
        # worker runs the playbook in the transmit | worker | process pipeline
        ansible-runner) case $v in run|start|worker) echo "apply ansible-runner $v" ;; esac ;;
        *) echo "apply $t" ;;
      esac ;;
    # Galaxy writes: collection/role publish, import, delete (also the old form without "role": ansible-galaxy delete)
    ansible-galaxy)
      case $v in
        publish|import|delete) echo "apply ansible-galaxy $v" ;;
        *) case $s in publish|import|delete) echo "apply ansible-galaxy $v $s" ;; esac ;;
      esac ;;
  esac
  return 0
}

IFS=';' read -ra segs <<<"$cmd"
# git writes are denied at once. apply/deploy commands (group apply, and ask for az invoke) get a permission prompt
# instead: remember the first one, preferring a destructive one, and keep scanning so a git write later still denies.
ask= askd=
for seg in "${segs[@]}"; do
  read -ra words <<<"$seg"
  [ ${#words[@]} -gt 0 ] || continue
  hit=$(check "${words[@]}")
  [ -n "$hit" ] || continue
  group=${hit%% *}; label=${hit#* }
  if [ "$group" = git ]; then
    [ "${DUTY_ALLOW_GIT_WRITE:-}" = 1 ] && continue
    reason="duty-framework: \`$label\` is blocked: no git writes, leave all changes uncommitted for the user to review (RULES.md). If the user explicitly asked for it, ask them to run it themselves, or to restart Claude Code with DUTY_ALLOW_GIT_WRITE=1."
    jq -cn --arg r "$reason" '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $r}}'
    exit 0
  fi
  [ "${DUTY_ALLOW_APPLY:-}" = 1 ] && continue
  destructive=
  for a in $label; do
    case $a in destroy|destroy-all|delete|delete-*|purge|purge-*|remove|uninstall|terminate-*|rm|rb|reimage|restore) destructive=1 ;; esac
  done
  # terraform/tofu/terragrunt state push overwrites the remote state
  case " $label " in *" state push "*) destructive=1 ;; esac
  # flags that make an apply destructive: terraform apply -destroy, aws s3 sync --delete
  for a in "${words[@]}"; do
    case $a in -destroy|--destroy|-destroy=true|--destroy=true|--delete) destructive=1; label="$label $a"; break ;; esac
  done
  # priority for the prompt text: destructive, then invoke (group ask), then any other apply
  if [ -n "$destructive" ]; then [ -n "$askd" ] || askd=$label
  elif [ -z "$ask" ] || { [ "$group" = ask ] && [ "${ask%% *}" != ask ]; }; then ask="$group $label"; fi
done
skip="DUTY_ALLOW_APPLY=1 skips this prompt for a session."
if [ -n "$askd" ]; then
  reason="duty-framework: DESTRUCTIVE: \`$askd\` deletes or overwrites something in a real environment (RULES.md). Approve only if you explicitly asked for exactly this. $skip"
elif [ "${ask%% *}" = ask ]; then
  reason="duty-framework: \`${ask#* }\` runs code on a real machine (RULES.md: real environments are read-only). Approve only if you asked for this run. $skip"
elif [ -n "$ask" ]; then
  reason="duty-framework: \`${ask#* }\` changes a real environment (RULES.md: read-only without explicit permission). Approve only if you asked for this change. $skip"
else
  exit 0
fi
jq -cn --arg r "$reason" '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "ask", permissionDecisionReason: $r}}'
exit 0
