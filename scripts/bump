#!/usr/bin/env bash
# Sets a plugin's version everywhere it is written: its .claude-plugin/plugin.json, its
# .plugin/plugin.json (only if that file has a "version") and its entry (matched by name) in the
# root .claude-plugin/marketplace.json.
# Usage: scripts/bump <duty-framework|duty-terraform|duty-ansible> <N.N.N>
# DUTY_ROOT=<dir> works on another checkout instead of this one (the tests use a temp copy).
# JSON is rewritten with jq (2-space indent), so inline {...} objects are expanded.
set -euo pipefail

usage() { echo "usage: ${0##*/} <duty-framework|duty-terraform|duty-ansible> <N.N.N>" >&2; exit 2; }
[ $# -eq 2 ] || usage
plugin=$1 version=$2
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || usage
ROOT=${DUTY_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}
case $plugin in
  duty-framework) dir=$ROOT ;;
  duty-terraform) dir=$ROOT/plugins/duty-terraform ;;
  duty-ansible) dir=$ROOT/plugins/duty-ansible ;;
  *) usage ;;
esac
command -v jq >/dev/null || { echo "${0##*/}: jq is required" >&2; exit 1; }

set_version() { # file, jq path expression of the version field (plugin.json: .version)
  local file=$1 path=$2 old tmp
  old=$(jq -r "$path // empty" "$file")
  tmp=$(mktemp)
  # write back into the original file (not mv): keeps its mode and owner, mktemp files are 0600
  jq --indent 2 --arg v "$version" "$path = \$v" "$file" >"$tmp" && cat "$tmp" >"$file"
  rm -f "$tmp"
  echo "$file: ${old:-none} -> $version"
}

claude=$dir/.claude-plugin/plugin.json market=$ROOT/.claude-plugin/marketplace.json
[ -f "$claude" ] || { echo "${0##*/}: missing $claude" >&2; exit 1; }
jq -e --arg n "$plugin" 'any(.plugins[]; .name == $n)' "$market" >/dev/null 2>&1 \
  || { echo "${0##*/}: $plugin is not listed in $market" >&2; exit 1; }

set_version "$claude" .version
[ -f "$dir/.plugin/plugin.json" ] && jq -e 'has("version")' "$dir/.plugin/plugin.json" >/dev/null 2>&1 \
  && set_version "$dir/.plugin/plugin.json" .version
set_version "$market" "(.plugins[] | select(.name == \"$plugin\") | .version)"
