#!/usr/bin/env bash
# Copilot CLI only: after a file view, nudges toward the ansible skill when the file is Ansible content
# (role files, playbooks, group_vars/host_vars, ansible.cfg, galaxy.yml, molecule). Other YAML stays silent.
# Silent elsewhere: Claude Code already loads the skill through its `paths` frontmatter.
# Copilot sends the path in .tool_input.path, Claude Code in .tool_input.file_path.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$ROOT/hooks/emit.sh"

[ -n "${COPILOT_CLI:-}" ] || exit 0

path=$(jq -r '.tool_input.path // .tool_input.file_path // empty' 2>/dev/null || true)
case "$path" in
  */roles/*/tasks/*.yml|*/roles/*/tasks/*.yaml|*/roles/*/handlers/*|*/roles/*/defaults/*|*/roles/*/vars/*|*/roles/*/meta/*|\
  */playbooks/*.yml|*/playbooks/*.yaml|*/group_vars/*|*/host_vars/*|*ansible.cfg|*/galaxy.yml|*/molecule/*.yml)
    emit PostToolUse 'Ansible file viewed: load the `ansible` skill (duty-ansible) before working on it.' ;;
esac
exit 0
